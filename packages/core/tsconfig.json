{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    // DOM types are allowed: core owns the canvas and the hotspot overlay.
    // C2 forbids UI *frameworks* and non-DOM host features, not the DOM itself.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "*.config.ts"]
}
