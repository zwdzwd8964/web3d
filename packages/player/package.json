{
  "name": "@w3/player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only player SPA. Size-sensitive (gzip <= 400KB, excluding assets).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:app && pnpm run build:embed",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "vite build",
    "build:embed": "vite build -c vite.embed.config.ts"
  },
  "dependencies": {
    "@w3/core": "workspace:*",
    "@w3/schema": "workspace:*",
    "@w3/storage": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.1.5"
  }
}
