# 由 nginx 官方 entrypoint 的 envsubst 渲染（只替换 ${PORT}，见 Dockerfile）。
server {
    listen      ${PORT};
    listen      [::]:${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # types 块是「替换」而不是「追加」继承来的 mime.types，所以这里要把用到的
    # 类型写全。.w3p / .hdr / .ktx2 / .bin / .drc 走 default_type，二进制读取
    # 不看 Content-Type。
    types {
        text/html           html;
        text/css            css;
        text/javascript     js mjs;
        application/json    json map webmanifest;
        application/wasm    wasm;
        image/png           png;
        image/jpeg          jpg jpeg;
        image/webp          webp;
        image/svg+xml       svg;
        image/x-icon        ico;
        font/woff2          woff2;
        model/gltf-binary   glb;
        model/gltf+json     gltf;
        text/plain          txt;
    }
    default_type application/octet-stream;

    # 只压文本类。.glb / .w3p / .hdr 本身已经是压缩格式，再压一遍纯烧 CPU。
    gzip            on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types      text/css text/javascript application/json application/wasm image/svg+xml;

    client_max_body_size 0;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Vite 产物带内容哈希，可以永久缓存。
    location ~* ^/(player/)?assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /vendor/ {
        expires 30d;
        try_files $uri =404;
    }

    # bench 页：**默认封死。**
    #
    # 它随 dist 一起部署到 /player/bench.html，是第二个公开入口且没有任何访问控制——
    # 任何知道地址的人都能让这台机器跑一轮压力测试。它只在验收时用一次，平时是纯风险。
    #
    # 临时开启：把下面这一行注释掉，reload nginx，用完再改回来。
    location = /player/bench.html {
        return 404;
    }

    # 播放器（构建时 --base=/player/）。
    location /player/ {
        # 谁可以把播放器嵌进 iframe。**默认谁都不许。**
        #
        # 改成客户的宿主域：frame-ancestors https://customer.example https://*.customer.example
        # 多个域用空格分开。改完之后还要同步 embed-policy.json 的白名单——
        # 这一条挡的是「谁能把我们放进 iframe」，那一份挡的是「谁能对我们说话」，
        # 两道锁各管一半，只配一半等于没配。
        #
        # **不用 X-Frame-Options**：它只认 DENY / SAMEORIGIN / 单个 ALLOW-FROM，而
        # ALLOW-FROM 早已被主流浏览器移除（Chrome 从未支持）。写一个客户域进去的结果是
        # 「在 Chrome 上等于没写、在 Firefox 上等于 DENY」——两种失败方式都不报错。
        add_header Content-Security-Policy "frame-ancestors 'none'" always;

        try_files $uri $uri/ /player/index.html;
    }

    # 编辑器。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
